# Copy this file to .env.local. Never commit .env.local.
# There is no login: private areas (/os, /sim, /lab, /admin) exist only
# in local `npm run dev`; the Vercel build ships only / and /sources.

# Public contact address shown on the landing page (mailto form)
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: public base URL for link previews/sitemap (e.g. https://punarnava.in).
# Leave empty on Vercel to use the production URL automatically.
NEXT_PUBLIC_SITE_URL=

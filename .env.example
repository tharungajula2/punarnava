# Copy this file to .env.local and fill in values. Never commit .env.local.
# "open" (default): /os, /sim, /lab, /admin need no login, full owner view.
# "locked": password protection below is enforced.
AUTH_MODE=open
# Owner password: full access incl. /admin. Investor password: read-only /os, /sim, /lab.
# Changing either one signs out everyone who used it.
OWNER_PASSWORD=
INVESTOR_PASSWORD=
# Random string, at least 32 characters. Signs the login cookie.
SESSION_SECRET=

# Public contact address shown on the landing page (mailto form)
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: public base URL for link previews/sitemap (e.g. https://punarnava.in).
# Leave empty on Vercel to use the production URL automatically.
NEXT_PUBLIC_SITE_URL=
